+function wireDraft(scope) {
+  const box = scope.querySelector("#draft");
+  if (!box) return;
+  const save = async () => {
+    await api(`/api/lectures/${encodeURIComponent(S.lecture.meta.stem)}/notes`, {
+      method: "PUT",
+      body: JSON.stringify({ markdown: box.value }),
+    });
+    S.lecture.markdown = box.value;
+  };
+  scope.querySelector("#draft-save").onclick = async () => { await save(); toast("Saved"); };
+  scope.querySelector("#draft-approve").onclick = async () => {
+    await save();
+    await navigator.clipboard.writeText(box.value);
+    toast("Approved and copied. Paste it into the group chat.");
+  };
+}
